# AfterFrame Server Configuration
PORT=5002
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or local connection string
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/afterframe?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/afterframe?retryWrites=true&w=majority

# TMDB API Credentials (Get free from https://www.themoviedb.org/settings/api)
# Provide either your v3 API Key OR your v4 Read Access Token (or both)
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# JWT Secret for user session tokens
JWT_SECRET=afterframe_secure_jwt_secret_key_cinema_2026
